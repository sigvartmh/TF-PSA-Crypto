+static psa_status_t mbedtls_psa_spake2p_import_fixed_point(
+    const mbedtls_ecp_group *grp,
+    mbedtls_ecp_point *P,
+    const uint8_t *encoded)
+{
+    return mbedtls_psa_spake2p_ecp_import_point(
+        grp, P, encoded, MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES);
+}
+
+static psa_status_t mbedtls_psa_spake2p_load_verifier_L(
+    const mbedtls_psa_spake2p_operation_t *operation,
+    const mbedtls_ecp_group *grp,
+    mbedtls_ecp_point *L)
+{
+    psa_status_t status;
+    mbedtls_mpi w1;
+
+    if (mbedtls_psa_spake2p_is_key_pair(operation->key_type)) {
+        mbedtls_mpi_init(&w1);
+        status = mbedtls_psa_spake2p_ecp_read_scalar(
+            grp, &w1,
+            operation->key + MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES,
+            MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+        if (status == PSA_SUCCESS) {
+            status = mbedtls_psa_spake2p_ecp_mul_base(grp, L, &w1);
+        }
+        mbedtls_mpi_free(&w1);
+        return status;
+    }
+
+    return mbedtls_psa_spake2p_ecp_import_point(
+        grp, L,
+        operation->key + MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES,
+        MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES);
+}

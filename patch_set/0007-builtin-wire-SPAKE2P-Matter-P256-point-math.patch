+static psa_status_t mbedtls_psa_spake2p_generate_scalar(
+    const mbedtls_ecp_group *grp,
+    uint8_t scalar[MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES])
+{
+    psa_status_t status = PSA_ERROR_INSUFFICIENT_ENTROPY;
+    mbedtls_mpi k;
+    unsigned attempts;
+
+    mbedtls_mpi_init(&k);
+
+    for (attempts = 0; attempts < MBEDTLS_PSA_SPAKE2P_RANDOM_SCALAR_TRIES;
+         attempts++) {
+        int ret = mbedtls_psa_get_random(MBEDTLS_PSA_RANDOM_STATE,
+                                         scalar,
+                                         MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+        if (ret != 0) {
+            status = PSA_ERROR_INSUFFICIENT_ENTROPY;
+            goto exit;
+        }
+
+        status = mbedtls_psa_spake2p_ecp_read_scalar(
+            grp, &k, scalar, MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+        if (status == PSA_SUCCESS) {
+            goto exit;
+        }
+        if (status != PSA_ERROR_INVALID_ARGUMENT) {
+            goto exit;
+        }
+    }
+
+    status = PSA_ERROR_INSUFFICIENT_ENTROPY;
+
+exit:
+    mbedtls_mpi_free(&k);
+    return status;
+}

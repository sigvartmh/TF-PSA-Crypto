+static psa_status_t mbedtls_psa_spake2p_compute_shared_points(
+    mbedtls_psa_spake2p_operation_t *operation)
+{
+    psa_status_t status;
+    mbedtls_ecp_group grp;
+    mbedtls_mpi w0;
+    mbedtls_mpi local_scalar;
+    mbedtls_mpi w1;
+    mbedtls_ecp_point peer;
+    mbedtls_ecp_point fixed;
+    mbedtls_ecp_point w0_fixed;
+    mbedtls_ecp_point base;
+    mbedtls_ecp_point L;
+    mbedtls_ecp_point Z;
+    mbedtls_ecp_point V;
+    size_t olen = 0;
+
+    if (!operation->local_scalar_is_set || !operation->peer_share_is_set) {
+        return PSA_ERROR_BAD_STATE;
+    }
+
+    mbedtls_ecp_group_init(&grp);
+    mbedtls_mpi_init(&w0);
+    mbedtls_mpi_init(&local_scalar);
+    mbedtls_mpi_init(&w1);
+    mbedtls_ecp_point_init(&peer);
+    mbedtls_ecp_point_init(&fixed);
+    mbedtls_ecp_point_init(&w0_fixed);
+    mbedtls_ecp_point_init(&base);
+    mbedtls_ecp_point_init(&L);
+    mbedtls_ecp_point_init(&Z);
+    mbedtls_ecp_point_init(&V);
+
+    status = mbedtls_psa_spake2p_load_p256(&grp);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_read_scalar(
+        &grp, &w0, operation->key,
+        MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_read_scalar(
+        &grp, &local_scalar, operation->local_scalar,
+        MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_import_point(
+        &grp, &peer, operation->peer_share,
+        MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_import_fixed_point(
+        &grp, &fixed,
+        operation->role == PSA_PAKE_ROLE_CLIENT ?
+        mbedtls_psa_spake2p_p256_N : mbedtls_psa_spake2p_p256_M);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_mul(&grp, &w0_fixed, &w0, &fixed);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_sub(&grp, &base, &peer, &w0_fixed);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_mul(&grp, &Z, &local_scalar, &base);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    if (operation->role == PSA_PAKE_ROLE_CLIENT) {
+        status = mbedtls_psa_spake2p_ecp_read_scalar(
+            &grp, &w1,
+            operation->key + MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES,
+            MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+        if (status != PSA_SUCCESS) {
+            goto exit;
+        }
+        status = mbedtls_psa_spake2p_ecp_mul(&grp, &V, &w1, &base);
+    } else {
+        status = mbedtls_psa_spake2p_load_verifier_L(operation, &grp, &L);
+        if (status != PSA_SUCCESS) {
+            goto exit;
+        }
+        status = mbedtls_psa_spake2p_ecp_mul(&grp, &V, &local_scalar, &L);
+    }
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_export_point(
+        &grp, &Z, operation->Z, sizeof(operation->Z), &olen);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    if (olen != MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES) {
+        status = PSA_ERROR_CORRUPTION_DETECTED;
+        goto exit;
+    }
+    operation->Z_len = olen;
+
+    status = mbedtls_psa_spake2p_ecp_export_point(
+        &grp, &V, operation->V, sizeof(operation->V), &olen);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    if (olen != MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES) {
+        status = PSA_ERROR_CORRUPTION_DETECTED;
+        goto exit;
+    }
+    operation->V_len = olen;
+    operation->Z_is_set = 1;
+    operation->V_is_set = 1;
+
+exit:
+    if (status != PSA_SUCCESS) {
+        mbedtls_platform_zeroize(operation->Z, sizeof(operation->Z));
+        mbedtls_platform_zeroize(operation->V, sizeof(operation->V));
+        operation->Z_len = 0;
+        operation->V_len = 0;
+        operation->Z_is_set = 0;
+        operation->V_is_set = 0;
+    }
+
+    mbedtls_ecp_point_free(&V);
+    mbedtls_ecp_point_free(&Z);
+    mbedtls_ecp_point_free(&L);
+    mbedtls_ecp_point_free(&base);
+    mbedtls_ecp_point_free(&w0_fixed);
+    mbedtls_ecp_point_free(&fixed);
+    mbedtls_ecp_point_free(&peer);
+    mbedtls_mpi_free(&w1);
+    mbedtls_mpi_free(&local_scalar);
+    mbedtls_mpi_free(&w0);
+    mbedtls_ecp_group_free(&grp);
+    return status;
+}
+
+static psa_status_t mbedtls_psa_spake2p_make_key_share(
+    mbedtls_psa_spake2p_operation_t *operation,
+    uint8_t *output,
+    size_t output_size,
+    size_t *output_length)
+{
+    psa_status_t status;
+    mbedtls_ecp_group grp;
+    mbedtls_mpi w0;
+    mbedtls_mpi local_scalar;
+    mbedtls_ecp_point fixed;
+    mbedtls_ecp_point scalar_base;
+    mbedtls_ecp_point w0_fixed;
+    mbedtls_ecp_point share;
+
+    if (output_length == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    *output_length = 0;
+
+    if (operation->state != MBEDTLS_PSA_SPAKE2P_STATE_READY) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (operation->local_share_is_set) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (operation->role == PSA_PAKE_ROLE_SERVER &&
+        !operation->peer_share_is_set) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (output_size < MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    mbedtls_ecp_group_init(&grp);
+    mbedtls_mpi_init(&w0);
+    mbedtls_mpi_init(&local_scalar);
+    mbedtls_ecp_point_init(&fixed);
+    mbedtls_ecp_point_init(&scalar_base);
+    mbedtls_ecp_point_init(&w0_fixed);
+    mbedtls_ecp_point_init(&share);
+
+    status = mbedtls_psa_spake2p_load_p256(&grp);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_read_scalar(
+        &grp, &w0, operation->key,
+        MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_generate_scalar(&grp, operation->local_scalar);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    operation->local_scalar_is_set = 1;
+
+    status = mbedtls_psa_spake2p_ecp_read_scalar(
+        &grp, &local_scalar, operation->local_scalar,
+        MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_import_fixed_point(
+        &grp, &fixed,
+        operation->role == PSA_PAKE_ROLE_CLIENT ?
+        mbedtls_psa_spake2p_p256_M : mbedtls_psa_spake2p_p256_N);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_mul_base(&grp, &scalar_base,
+                                              &local_scalar);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_mul(&grp, &w0_fixed, &w0, &fixed);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_add(&grp, &share, &scalar_base,
+                                         &w0_fixed);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_export_point(
+        &grp, &share, output, output_size, output_length);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    if (*output_length != MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES) {
+        status = PSA_ERROR_CORRUPTION_DETECTED;
+        goto exit;
+    }
+
+    memcpy(operation->local_share, output, *output_length);
+    operation->local_share_is_set = 1;
+
+    if (operation->peer_share_is_set) {
+        status = mbedtls_psa_spake2p_compute_shared_points(operation);
+    }
+
+exit:
+    if (status != PSA_SUCCESS) {
+        mbedtls_platform_zeroize(operation->local_scalar,
+                                 sizeof(operation->local_scalar));
+        mbedtls_platform_zeroize(operation->local_share,
+                                 sizeof(operation->local_share));
+        operation->local_scalar_is_set = 0;
+        operation->local_share_is_set = 0;
+        *output_length = 0;
+    }
+
+    mbedtls_ecp_point_free(&share);
+    mbedtls_ecp_point_free(&w0_fixed);
+    mbedtls_ecp_point_free(&scalar_base);
+    mbedtls_ecp_point_free(&fixed);
+    mbedtls_mpi_free(&local_scalar);
+    mbedtls_mpi_free(&w0);
+    mbedtls_ecp_group_free(&grp);
+    return status;
+}
+
+static psa_status_t mbedtls_psa_spake2p_read_peer_share(
+    mbedtls_psa_spake2p_operation_t *operation,
+    const uint8_t *input,
+    size_t input_length)
+{
+    psa_status_t status;
+    mbedtls_ecp_group grp;
+    mbedtls_ecp_point peer;
+
+    if (operation->state != MBEDTLS_PSA_SPAKE2P_STATE_READY) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (operation->peer_share_is_set) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (input == NULL ||
+        input_length != MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    mbedtls_ecp_group_init(&grp);
+    mbedtls_ecp_point_init(&peer);
+
+    status = mbedtls_psa_spake2p_load_p256(&grp);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    status = mbedtls_psa_spake2p_ecp_import_point(&grp, &peer, input,
+                                                  input_length);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    memcpy(operation->peer_share, input, input_length);
+    operation->peer_share_is_set = 1;
+
+    if (operation->local_scalar_is_set) {
+        status = mbedtls_psa_spake2p_compute_shared_points(operation);
+    }
+
+exit:
+    mbedtls_ecp_point_free(&peer);
+    mbedtls_ecp_group_free(&grp);
+    return status;
+}

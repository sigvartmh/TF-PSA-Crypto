+#!/usr/bin/env bash
+#
+# Build-and-test job for the Matter SPAKE2+ P-256 PSA PAKE profile.
+#
+# This script is intentionally small and CI-friendly. It enables only the
+# SPAKE2+ Matter selector plus test hooks on top of the checked-out
+# configuration, then builds the generated CMake tree and runs the PAKE tests.
+#
+# Environment variables:
+#   BUILD_DIR        Build directory to use. Default: build-spake2p-matter-p256
+#   CMAKE_BUILD_TYPE CMake build type. Default: Debug
+#   JOBS             Parallel build jobs. Default: 2
+#   PYTHON           Python interpreter. Default: python3
+
+set -eu
+set -o pipefail
+
+ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+cd "$ROOT_DIR"
+
+BUILD_DIR=${BUILD_DIR:-build-spake2p-matter-p256}
+CMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE:-Debug}
+JOBS=${JOBS:-2}
+PYTHON=${PYTHON:-python3}
+CONFIG_FILE="include/psa/crypto_config.h"
+
+if [ ! -f "$CONFIG_FILE" ]; then
+    echo "error: $CONFIG_FILE not found" >&2
+    exit 1
+fi
+
+config_backup=$(mktemp "${TMPDIR:-/tmp}/tf-psa-crypto-config.XXXXXX")
+cp "$CONFIG_FILE" "$config_backup"
+restore_config() {
+    cp "$config_backup" "$CONFIG_FILE"
+    rm -f "$config_backup"
+}
+trap restore_config EXIT HUP INT TERM
+
+"$PYTHON" scripts/config.py set PSA_WANT_ALG_SPAKE2P_MATTER
+"$PYTHON" scripts/config.py set MBEDTLS_TEST_HOOKS
+
+rm -rf "$BUILD_DIR"
+cmake -S . -B "$BUILD_DIR" -D CMAKE_BUILD_TYPE="$CMAKE_BUILD_TYPE"
+cmake --build "$BUILD_DIR" --parallel "$JOBS"
+
+ctest --test-dir "$BUILD_DIR" --output-on-failure \
+    -R 'test_suite_psa_crypto_(pake|spake2p)'

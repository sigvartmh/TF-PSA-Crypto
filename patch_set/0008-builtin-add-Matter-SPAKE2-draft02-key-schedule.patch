+static psa_status_t mbedtls_psa_spake2p_derive_keys(
+    mbedtls_psa_spake2p_operation_t *operation)
+{
+    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
+    const mbedtls_md_info_t *md_info;
+    mbedtls_md_context_t hash_ctx;
+    const uint8_t *A;
+    const uint8_t *B;
+    size_t A_len;
+    size_t B_len;
+    const uint8_t *X;
+    const uint8_t *Y;
+    uint8_t Kae[MBEDTLS_PSA_SPAKE2P_HASH_BYTES];
+    uint8_t Kcab[MBEDTLS_PSA_SPAKE2P_HASH_BYTES];
+    int ret;
+
+    if (operation->keys_are_set) {
+        return PSA_SUCCESS;
+    }
+
+    if (!operation->local_share_is_set || !operation->peer_share_is_set ||
+        !operation->Z_is_set || !operation->V_is_set) {
+        return PSA_ERROR_BAD_STATE;
+    }
+
+    if (operation->role == PSA_PAKE_ROLE_CLIENT) {
+        A = operation->user;
+        A_len = operation->user_len;
+        B = operation->peer;
+        B_len = operation->peer_len;
+        X = operation->local_share;
+        Y = operation->peer_share;
+    } else if (operation->role == PSA_PAKE_ROLE_SERVER) {
+        A = operation->peer;
+        A_len = operation->peer_len;
+        B = operation->user;
+        B_len = operation->user_len;
+        X = operation->peer_share;
+        Y = operation->local_share;
+    } else {
+        return PSA_ERROR_BAD_STATE;
+    }
+
+    memset(Kae, 0, sizeof(Kae));
+    memset(Kcab, 0, sizeof(Kcab));
+
+    md_info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    if (md_info == NULL) {
+        return PSA_ERROR_NOT_SUPPORTED;
+    }
+
+    mbedtls_md_init(&hash_ctx);
+
+    ret = mbedtls_md_setup(&hash_ctx, md_info, 0);
+    if (ret != 0) {
+        status = mbedtls_psa_spake2p_md_status(ret);
+        goto exit;
+    }
+
+    ret = mbedtls_md_starts(&hash_ctx);
+    if (ret != 0) {
+        status = mbedtls_psa_spake2p_md_status(ret);
+        goto exit;
+    }
+
+    if (operation->context_is_set) {
+        status = mbedtls_psa_spake2p_hash_update_block(
+            &hash_ctx, operation->context, operation->context_len);
+        if (status != PSA_SUCCESS) {
+            goto exit;
+        }
+    }
+
+    status = mbedtls_psa_spake2p_hash_update_block(&hash_ctx, A, A_len);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    status = mbedtls_psa_spake2p_hash_update_block(&hash_ctx, B, B_len);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    status = mbedtls_psa_spake2p_hash_update_block(
+        &hash_ctx, mbedtls_psa_spake2p_p256_M,
+        sizeof(mbedtls_psa_spake2p_p256_M));
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    status = mbedtls_psa_spake2p_hash_update_block(
+        &hash_ctx, mbedtls_psa_spake2p_p256_N,
+        sizeof(mbedtls_psa_spake2p_p256_N));
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    status = mbedtls_psa_spake2p_hash_update_block(
+        &hash_ctx, X, MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    status = mbedtls_psa_spake2p_hash_update_block(
+        &hash_ctx, Y, MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    status = mbedtls_psa_spake2p_hash_update_block(
+        &hash_ctx, operation->Z, operation->Z_len);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    status = mbedtls_psa_spake2p_hash_update_block(
+        &hash_ctx, operation->V, operation->V_len);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+    status = mbedtls_psa_spake2p_hash_update_block(
+        &hash_ctx, operation->key,
+        MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES);
+    if (status != PSA_SUCCESS) {
+        goto exit;
+    }
+
+    ret = mbedtls_md_finish(&hash_ctx, Kae);
+    if (ret != 0) {
+        status = mbedtls_psa_spake2p_md_status(ret);
+        goto exit;
+    }
+
+    ret = mbedtls_hkdf(md_info,
+                       NULL, 0,
+                       Kae, MBEDTLS_PSA_SPAKE2P_AUTH_KEY_BYTES,
+                       mbedtls_psa_spake2p_info_confirmation_keys,
+                       sizeof(mbedtls_psa_spake2p_info_confirmation_keys),
+                       Kcab, sizeof(Kcab));
+    if (ret != 0) {
+        status = mbedtls_psa_spake2p_md_status(ret);
+        goto exit;
+    }
+
+    memcpy(operation->Kca, Kcab, MBEDTLS_PSA_SPAKE2P_AUTH_KEY_BYTES);
+    memcpy(operation->Kcb, Kcab + MBEDTLS_PSA_SPAKE2P_AUTH_KEY_BYTES,
+           MBEDTLS_PSA_SPAKE2P_AUTH_KEY_BYTES);
+    memcpy(operation->shared_key,
+           Kae + MBEDTLS_PSA_SPAKE2P_AUTH_KEY_BYTES,
+           MBEDTLS_PSA_SPAKE2P_SHARED_KEY_BYTES);
+    operation->keys_are_set = 1;
+    status = PSA_SUCCESS;
+
+exit:
+    mbedtls_md_free(&hash_ctx);
+    mbedtls_platform_zeroize(Kae, sizeof(Kae));
+    mbedtls_platform_zeroize(Kcab, sizeof(Kcab));
+    if (status != PSA_SUCCESS) {
+        mbedtls_platform_zeroize(operation->Kca, sizeof(operation->Kca));
+        mbedtls_platform_zeroize(operation->Kcb, sizeof(operation->Kcb));
+        mbedtls_platform_zeroize(operation->shared_key,
+                                 sizeof(operation->shared_key));
+        operation->keys_are_set = 0;
+    }
+    return status;
+}
+
+static psa_status_t mbedtls_psa_spake2p_compute_confirm(
+    mbedtls_psa_spake2p_operation_t *operation,
+    int for_output,
+    uint8_t output[MBEDTLS_PSA_SPAKE2P_CONFIRM_BYTES])
+{
+    psa_status_t status;
+    const mbedtls_md_info_t *md_info;
+    const uint8_t *key;
+    const uint8_t *message;
+    int ret;
+
+    status = mbedtls_psa_spake2p_derive_keys(operation);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    if (operation->role == PSA_PAKE_ROLE_CLIENT) {
+        key = for_output ? operation->Kca : operation->Kcb;
+        message = for_output ? operation->peer_share : operation->local_share;
+    } else if (operation->role == PSA_PAKE_ROLE_SERVER) {
+        key = for_output ? operation->Kcb : operation->Kca;
+        message = for_output ? operation->peer_share : operation->local_share;
+    } else {
+        return PSA_ERROR_BAD_STATE;
+    }
+
+    md_info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    if (md_info == NULL) {
+        return PSA_ERROR_NOT_SUPPORTED;
+    }
+
+    ret = mbedtls_md_hmac(md_info,
+                          key, MBEDTLS_PSA_SPAKE2P_AUTH_KEY_BYTES,
+                          message, MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES,
+                          output);
+    return mbedtls_psa_spake2p_md_status(ret);
+}
+
+static psa_status_t mbedtls_psa_spake2p_output_confirm(
+    mbedtls_psa_spake2p_operation_t *operation,
+    uint8_t *output,
+    size_t output_size,
+    size_t *output_length)
+{
+    psa_status_t status;
+
+    if (output == NULL || output_length == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    *output_length = 0;
+
+    if (operation->state != MBEDTLS_PSA_SPAKE2P_STATE_READY ||
+        !operation->Z_is_set || !operation->V_is_set) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (operation->local_confirm_is_output) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (operation->role == PSA_PAKE_ROLE_CLIENT &&
+        !operation->peer_confirm_is_verified) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (output_size < MBEDTLS_PSA_SPAKE2P_CONFIRM_BYTES) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    status = mbedtls_psa_spake2p_compute_confirm(operation, 1, output);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    *output_length = MBEDTLS_PSA_SPAKE2P_CONFIRM_BYTES;
+    operation->local_confirm_is_output = 1;
+    return PSA_SUCCESS;
+}
+
+static psa_status_t mbedtls_psa_spake2p_input_confirm(
+    mbedtls_psa_spake2p_operation_t *operation,
+    const uint8_t *input,
+    size_t input_length)
+{
+    psa_status_t status;
+    uint8_t expected[MBEDTLS_PSA_SPAKE2P_CONFIRM_BYTES];
+
+    if (input == NULL || input_length != MBEDTLS_PSA_SPAKE2P_CONFIRM_BYTES) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+    if (operation->state != MBEDTLS_PSA_SPAKE2P_STATE_READY ||
+        !operation->Z_is_set || !operation->V_is_set) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (operation->peer_confirm_is_verified) {
+        return PSA_ERROR_BAD_STATE;
+    }
+    if (operation->role == PSA_PAKE_ROLE_SERVER &&
+        !operation->local_confirm_is_output) {
+        return PSA_ERROR_BAD_STATE;
+    }
+
+    status = mbedtls_psa_spake2p_compute_confirm(operation, 0, expected);
+    if (status != PSA_SUCCESS) {
+        mbedtls_platform_zeroize(expected, sizeof(expected));
+        return status;
+    }
+
+    if (mbedtls_psa_spake2p_ct_memcmp(expected, input, sizeof(expected)) != 0) {
+        mbedtls_platform_zeroize(expected, sizeof(expected));
+        return PSA_ERROR_INVALID_SIGNATURE;
+    }
+
+    mbedtls_platform_zeroize(expected, sizeof(expected));
+    operation->peer_confirm_is_verified = 1;
+    return PSA_SUCCESS;
+}

+static psa_status_t mbedtls_psa_spake2p_md_status(int ret)
+{
+    if (ret == 0) {
+        return PSA_SUCCESS;
+    }
+
+    switch (ret) {
+        case MBEDTLS_ERR_MD_ALLOC_FAILED:
+            return PSA_ERROR_INSUFFICIENT_MEMORY;
+        case MBEDTLS_ERR_MD_FEATURE_UNAVAILABLE:
+            return PSA_ERROR_NOT_SUPPORTED;
+        case MBEDTLS_ERR_MD_BAD_INPUT_DATA:
+            return PSA_ERROR_INVALID_ARGUMENT;
+        default:
+            return PSA_ERROR_CORRUPTION_DETECTED;
+    }
+}
+
+static psa_status_t mbedtls_psa_spake2p_hash_update(
+    mbedtls_md_context_t *ctx,
+    const uint8_t *data,
+    size_t data_length)
+{
+    int ret;
+
+    if (data_length == 0) {
+        return PSA_SUCCESS;
+    }
+    if (data == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    ret = mbedtls_md_update(ctx, data, data_length);
+    return mbedtls_psa_spake2p_md_status(ret);
+}
+
+static psa_status_t mbedtls_psa_spake2p_hash_update_length(
+    mbedtls_md_context_t *ctx,
+    size_t data_length)
+{
+    uint64_t length = data_length;
+    uint8_t encoded[8];
+    size_t i;
+
+    for (i = 0; i < sizeof(encoded); i++) {
+        encoded[i] = (uint8_t) (length >> (8u * i));
+    }
+
+    return mbedtls_psa_spake2p_hash_update(ctx, encoded, sizeof(encoded));
+}
+
+static psa_status_t mbedtls_psa_spake2p_hash_update_block(
+    mbedtls_md_context_t *ctx,
+    const uint8_t *data,
+    size_t data_length)
+{
+    psa_status_t status;
+
+    status = mbedtls_psa_spake2p_hash_update_length(ctx, data_length);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    return mbedtls_psa_spake2p_hash_update(ctx, data, data_length);
+}

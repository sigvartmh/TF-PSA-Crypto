@@ -0,0 +1,37 @@
+Matter SPAKE2+ P-256 deterministic interop vector.
+
+This vector follows the connectedhomeip Matter SPAKE2+ draft-02 flow:
+  TT = len(Context) || Context
+     || len(A) || A || len(B) || B
+     || len(M) || M || len(N) || N
+     || len(X) || X || len(Y) || Y
+     || len(Z) || Z || len(V) || V
+     || len(w0) || w0
+  Kae = SHA256(TT)
+  Ka = Kae[0..15]
+  Ke = Kae[16..31]
+  Kca || Kcb = HKDF-SHA256(ikm = Ka,
+                            salt = nil,
+                            info = "ConfirmationKeys",
+                            L = 32)
+  confirmP = HMAC-SHA256(Kca, shareV)
+  confirmV = HMAC-SHA256(Kcb, shareP)
+
+A/client = 636c69656e74
+B/server = 736572766572
+Context = 4d6174746572205350414b45322b2050323536207465737420636f6e74657874
+w0 = 0827c8c6230d1318f075182db436c8d79bf29aebc89510bbc78b145d50c9bf44
+w1 = e7d47c0863552a5d3d73c5b30715a430e7a4bf92eb47e86c1cf85d1c57b66911
+x = dc09d5bcd6b34fce99207dabd2e5ce71af3f26597867ddc02c5fc30829fc90c2
+y = a821aa76e0a3f1ba7840fc88dedb4e5473e3249ae3455a8a633f7f677d380b9a
+L = 04bfa7b5eda26af87246cefc3898013af4828968bdc0a26440d3c329600a3df8e3dd7f450995b41f1c242e2c0affe56c65460b06109f44389d225813f83d8bd340
+shareP = 04dc08124d9a1f1bb5d1971b15e735a734bbd9d4dbce73e54b8e08d6d4189801307ae38c2cf0bae92f267b858df138cd92b1ebf113888f364add15ea981634fb95
+shareV = 0414dac850052d2b12fc82bb2e08e6d60f69f17ad85c6f260c0399b8e3e87e0d7260e03369d8e0d0d4079c466ce53404b7db742b2049684857c4740940b563d3c3
+Z = 045af7d46bcfd498c7f0909d3a49738df8f40ff3896c76c6a11e1e369a4ae7c23d38a90b0de192e8bbdf58cfe77cb13d74b20250063253ae9bcea7f02638fffe14
+V = 048a3a5169dec00bccc5e93a46259ba0b25bf3bbe39480db064a78e5b9cc81ea3dd726eb894a432c197543ae150fa1d7a5049957090f03f934e3d1c7a7ae97522f
+Ka = 458a98ed9deab5eb5e931f10724a55f7
+Ke = b93a7e8551155cfe76e76dadabdbb0d6
+Kca = d92be283e42fdbc0182ef141be48ea54
+Kcb = 6c5818cd6af325e3277d0b741338e833
+confirmP = 6f3ac336f8ed6a8057d1ae648de5794ddccba6693b0b16f460b5469138d83959
+confirmV = 0b4bc4bdf5b027a16b6654fd7c2e8b10fb72830ec0ea1bcdf1b9de088074990c

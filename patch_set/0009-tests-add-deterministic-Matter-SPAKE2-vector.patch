+    size_t user_len,
+    const uint8_t *peer,
+    size_t peer_len,
+    const uint8_t *context,
+    size_t context_len)
+{
+    psa_pake_cipher_suite_t suite;
+    psa_status_t status;
+
+    spake2p_matter_init_suite(&suite);
+    status = psa_pake_setup(operation, key, &suite);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+    status = psa_pake_set_role(operation, role);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+    status = psa_pake_set_user(operation, user, user_len);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+    status = psa_pake_set_peer(operation, peer, peer_len);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+    return psa_pake_set_context(operation, context, context_len);
+}

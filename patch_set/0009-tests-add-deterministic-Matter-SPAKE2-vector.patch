+void spake2p_matter_interop_vector( void )
+{
+#if defined(MBEDTLS_TEST_HOOKS)
+    psa_key_id_t client_key = MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_id_t server_key = MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_id_t client_shared = MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_id_t server_shared = MBEDTLS_SVC_KEY_ID_INIT;
+    psa_pake_operation_t client = PSA_PAKE_OPERATION_INIT;
+    psa_pake_operation_t server = PSA_PAKE_OPERATION_INIT;
+    psa_key_attributes_t shared_attributes = PSA_KEY_ATTRIBUTES_INIT;
+    uint8_t share_p[SPAKE2P_P256_POINT_BYTES];
+    uint8_t share_v[SPAKE2P_P256_POINT_BYTES];
+    uint8_t confirm_p[SPAKE2P_CONFIRM_BYTES];
+    uint8_t confirm_v[SPAKE2P_CONFIRM_BYTES];
+    uint8_t exported[SPAKE2P_SHARED_KEY_BYTES];
+    size_t output_length = 0;
+
+    PSA_ASSERT( psa_crypto_init() );
+    PSA_ASSERT( spake2p_matter_import_keypair(&client_key) );
+    PSA_ASSERT( spake2p_matter_import_keypair(&server_key) );
+
+    PSA_ASSERT( spake2p_matter_setup_party(
+        &client, client_key, PSA_PAKE_ROLE_CLIENT,
+        spake2p_matter_client_id, sizeof(spake2p_matter_client_id),
+        spake2p_matter_server_id, sizeof(spake2p_matter_server_id),
+        spake2p_matter_context, sizeof(spake2p_matter_context)) );
+    PSA_ASSERT( spake2p_matter_setup_party(
+        &server, server_key, PSA_PAKE_ROLE_SERVER,
+        spake2p_matter_server_id, sizeof(spake2p_matter_server_id),
+        spake2p_matter_client_id, sizeof(spake2p_matter_client_id),
+        spake2p_matter_context, sizeof(spake2p_matter_context)) );
+
+    PSA_ASSERT( mbedtls_psa_spake2p_test_set_next_scalar(
+        spake2p_matter_client_scalar) );
+    PSA_ASSERT( psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
+                                share_p, sizeof(share_p), &output_length) );
+    TEST_MEMORY_COMPARE(share_p, output_length,
+                        spake2p_matter_share_p,
+                        sizeof(spake2p_matter_share_p));
+
+    PSA_ASSERT( psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE,
+                               share_p, output_length) );
+    PSA_ASSERT( mbedtls_psa_spake2p_test_set_next_scalar(
+        spake2p_matter_server_scalar) );
+    PSA_ASSERT( psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
+                                share_v, sizeof(share_v), &output_length) );
+    TEST_MEMORY_COMPARE(share_v, output_length,
+                        spake2p_matter_share_v,
+                        sizeof(spake2p_matter_share_v));
+
+    PSA_ASSERT( psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
+                                confirm_v, sizeof(confirm_v),
+                                &output_length) );
+    TEST_MEMORY_COMPARE(confirm_v, output_length,
+                        spake2p_matter_confirm_v,
+                        sizeof(spake2p_matter_confirm_v));
+
+    PSA_ASSERT( psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE,
+                               share_v, sizeof(share_v)) );
+    PSA_ASSERT( psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM,
+                               confirm_v, sizeof(confirm_v)) );
+    PSA_ASSERT( psa_pake_output(&client, PSA_PAKE_STEP_CONFIRM,
+                                confirm_p, sizeof(confirm_p),
+                                &output_length) );
+    TEST_MEMORY_COMPARE(confirm_p, output_length,
+                        spake2p_matter_confirm_p,
+                        sizeof(spake2p_matter_confirm_p));
+
+    PSA_ASSERT( psa_pake_input(&server, PSA_PAKE_STEP_CONFIRM,
+                               confirm_p, sizeof(confirm_p)) );
+
+    psa_set_key_type(&shared_attributes, PSA_KEY_TYPE_RAW_DATA);
+    psa_set_key_usage_flags(&shared_attributes, PSA_KEY_USAGE_EXPORT);
+    PSA_ASSERT( psa_pake_get_shared_key(&client, &shared_attributes,
+                                        &client_shared) );
+    PSA_ASSERT( psa_pake_get_shared_key(&server, &shared_attributes,
+                                        &server_shared) );
+
+    PSA_ASSERT( psa_export_key(client_shared, exported, sizeof(exported),
+                               &output_length) );
+    TEST_MEMORY_COMPARE(exported, output_length,
+                        spake2p_matter_shared_key,
+                        sizeof(spake2p_matter_shared_key));
+    PSA_ASSERT( psa_export_key(server_shared, exported, sizeof(exported),
+                               &output_length) );
+    TEST_MEMORY_COMPARE(exported, output_length,
+                        spake2p_matter_shared_key,
+                        sizeof(spake2p_matter_shared_key));
+
+exit:
+    psa_reset_key_attributes(&shared_attributes);
+    psa_destroy_key(client_shared);
+    psa_destroy_key(server_shared);
+    psa_destroy_key(client_key);
+    psa_destroy_key(server_key);
+    psa_pake_abort(&client);
+    psa_pake_abort(&server);
+#else
+    TEST_ASSERT(0);
+#endif
+}

diff --git a/drivers/builtin/src/psa_crypto_spake2p.c b/drivers/builtin/src/psa_crypto_spake2p.c
new file mode 100644
index 0000000..1fe1d6d
--- /dev/null
+++ b/drivers/builtin/src/psa_crypto_spake2p.c
@@ -0,0 +1,269 @@
+/*
+ *  SPAKE2+ Matter built-in PAKE engine
+ */
+/*
+ *  Copyright The Mbed TLS Contributors
+ *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later
+ */
+
+#include "tf_psa_crypto_common.h"
+
+#if defined(MBEDTLS_PSA_CRYPTO_C) && defined(MBEDTLS_PSA_BUILTIN_ALG_SPAKE2P)
+
+#include <psa/crypto.h>
+#include "psa_crypto_spake2p.h"
+
+#include "mbedtls/platform.h"
+#include "mbedtls/platform_util.h"
+
+#include <string.h>
+
+static psa_status_t mbedtls_psa_spake2p_copy_optional_input(
+    uint8_t **dst,
+    size_t *dst_len,
+    psa_status_t (*get_len)(const psa_crypto_driver_pake_inputs_t *, size_t *),
+    psa_status_t (*get)(const psa_crypto_driver_pake_inputs_t *,
+                        uint8_t *, size_t, size_t *),
+    const psa_crypto_driver_pake_inputs_t *inputs)
+{
+    psa_status_t status;
+    size_t length = 0;
+    size_t actual_length = 0;
+
+    status = get_len(inputs, &length);
+    if (status == PSA_ERROR_BAD_STATE) {
+        *dst = NULL;
+        *dst_len = 0;
+        return PSA_SUCCESS;
+    }
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    if (length == 0) {
+        *dst = NULL;
+        *dst_len = 0;
+        return PSA_SUCCESS;
+    }
+
+    *dst = mbedtls_calloc(1, length);
+    if (*dst == NULL) {
+        return PSA_ERROR_INSUFFICIENT_MEMORY;
+    }
+
+    status = get(inputs, *dst, length, &actual_length);
+    if (status != PSA_SUCCESS) {
+        mbedtls_free(*dst);
+        *dst = NULL;
+        *dst_len = 0;
+        return status;
+    }
+
+    if (actual_length != length) {
+        mbedtls_free(*dst);
+        *dst = NULL;
+        *dst_len = 0;
+        return PSA_ERROR_CORRUPTION_DETECTED;
+    }
+
+    *dst_len = actual_length;
+    return PSA_SUCCESS;
+}
+
+psa_status_t mbedtls_psa_spake2p_setup(
+    mbedtls_psa_spake2p_operation_t *operation,
+    const psa_crypto_driver_pake_inputs_t *inputs)
+{
+    psa_status_t status;
+    psa_pake_cipher_suite_t cipher_suite = psa_pake_cipher_suite_init();
+    psa_pake_role_t role = PSA_PAKE_ROLE_NONE;
+    size_t key_len = 0;
+    size_t actual_key_len = 0;
+
+    if (operation == NULL || inputs == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    memset(operation, 0, sizeof(*operation));
+
+    status = psa_crypto_driver_pake_get_cipher_suite(inputs,
+                                                     &cipher_suite);
+    if (status != PSA_SUCCESS) {
+        goto error;
+    }
+
+    if (cipher_suite.algorithm != PSA_ALG_SPAKE2P_MATTER ||
+        cipher_suite.type != PSA_PAKE_PRIMITIVE_TYPE_ECC ||
+        cipher_suite.family != PSA_ECC_FAMILY_SECP_R1 ||
+        cipher_suite.bits != 256 ||
+        cipher_suite.key_confirmation != PSA_PAKE_CONFIRMED_KEY) {
+        status = PSA_ERROR_NOT_SUPPORTED;
+        goto error;
+    }
+
+    status = psa_crypto_driver_pake_get_role(inputs, &role);
+    if (status != PSA_SUCCESS) {
+        goto error;
+    }
+    if (role != PSA_PAKE_ROLE_CLIENT &&
+        role != PSA_PAKE_ROLE_SERVER) {
+        status = PSA_ERROR_INVALID_ARGUMENT;
+        goto error;
+    }
+
+    operation->key_type = psa_get_key_type(&inputs->attributes);
+    if (!PSA_KEY_TYPE_IS_SPAKE2P(operation->key_type)) {
+        status = PSA_ERROR_INVALID_ARGUMENT;
+        goto error;
+    }
+
+    status = psa_crypto_driver_pake_get_key_len(inputs, &key_len);
+    if (status != PSA_SUCCESS) {
+        goto error;
+    }
+    if (key_len != MBEDTLS_PSA_SPAKE2P_P256_KEYPAIR_BYTES &&
+        key_len != MBEDTLS_PSA_SPAKE2P_P256_PUBLIC_BYTES) {
+        status = PSA_ERROR_INVALID_ARGUMENT;
+        goto error;
+    }
+
+    if (role == PSA_PAKE_ROLE_CLIENT &&
+        !PSA_KEY_TYPE_IS_SPAKE2P_KEY_PAIR(operation->key_type)) {
+        status = PSA_ERROR_INVALID_ARGUMENT;
+        goto error;
+    }
+
+    status = psa_crypto_driver_pake_get_key(inputs, operation->key,
+                                            sizeof(operation->key),
+                                            &actual_key_len);
+    if (status != PSA_SUCCESS) {
+        goto error;
+    }
+    if (actual_key_len != key_len) {
+        status = PSA_ERROR_CORRUPTION_DETECTED;
+        goto error;
+    }
+    operation->key_len = key_len;
+
+    status = mbedtls_psa_spake2p_copy_optional_input(
+        &operation->user, &operation->user_len,
+        psa_crypto_driver_pake_get_user_len,
+        psa_crypto_driver_pake_get_user, inputs);
+    if (status != PSA_SUCCESS) {
+        goto error;
+    }
+
+    status = mbedtls_psa_spake2p_copy_optional_input(
+        &operation->peer, &operation->peer_len,
+        psa_crypto_driver_pake_get_peer_len,
+        psa_crypto_driver_pake_get_peer, inputs);
+    if (status != PSA_SUCCESS) {
+        goto error;
+    }
+
+    status = psa_crypto_driver_pake_get_context_len(inputs,
+                                                    &operation->context_len);
+    if (status == PSA_SUCCESS) {
+        operation->context_is_set = 1;
+        if (operation->context_len != 0) {
+            size_t actual_context_len = 0;
+
+            operation->context = mbedtls_calloc(1, operation->context_len);
+            if (operation->context == NULL) {
+                status = PSA_ERROR_INSUFFICIENT_MEMORY;
+                goto error;
+            }
+            status = psa_crypto_driver_pake_get_context(
+                inputs, operation->context, operation->context_len,
+                &actual_context_len);
+            if (status != PSA_SUCCESS) {
+                goto error;
+            }
+            if (actual_context_len != operation->context_len) {
+                status = PSA_ERROR_CORRUPTION_DETECTED;
+                goto error;
+            }
+        }
+    } else if (status == PSA_ERROR_BAD_STATE) {
+        status = PSA_SUCCESS;
+    } else {
+        goto error;
+    }
+
+    operation->role = role;
+    operation->alg = cipher_suite.algorithm;
+    operation->state = MBEDTLS_PSA_SPAKE2P_STATE_READY;
+    return PSA_SUCCESS;
+
+error:
+    mbedtls_psa_spake2p_abort(operation);
+    return status;
+}
+
+psa_status_t mbedtls_psa_spake2p_output(
+    mbedtls_psa_spake2p_operation_t *operation,
+    int step,
+    uint8_t *output,
+    size_t output_size,
+    size_t *output_length)
+{
+    (void) operation;
+    (void) step;
+    (void) output;
+    (void) output_size;
+    if (output_length != NULL) {
+        *output_length = 0;
+    }
+
+    /* Protocol math lands in the follow-up engine patch. */
+    return PSA_ERROR_NOT_SUPPORTED;
+}
+
+psa_status_t mbedtls_psa_spake2p_input(
+    mbedtls_psa_spake2p_operation_t *operation,
+    int step,
+    const uint8_t *input,
+    size_t input_length)
+{
+    (void) operation;
+    (void) step;
+    (void) input;
+    (void) input_length;
+
+    /* Protocol math lands in the follow-up engine patch. */
+    return PSA_ERROR_NOT_SUPPORTED;
+}
+
+psa_status_t mbedtls_psa_spake2p_get_shared_key(
+    mbedtls_psa_spake2p_operation_t *operation,
+    uint8_t *output,
+    size_t output_size,
+    size_t *output_length)
+{
+    (void) operation;
+    (void) output;
+    (void) output_size;
+    if (output_length != NULL) {
+        *output_length = 0;
+    }
+
+    /* Protocol math lands in the follow-up engine patch. */
+    return PSA_ERROR_NOT_SUPPORTED;
+}
+
+psa_status_t mbedtls_psa_spake2p_abort(
+    mbedtls_psa_spake2p_operation_t *operation)
+{
+    if (operation == NULL) {
+        return PSA_SUCCESS;
+    }
+
+    mbedtls_platform_zeroize(operation->key, sizeof(operation->key));
+    mbedtls_free(operation->user);
+    mbedtls_free(operation->peer);
+    mbedtls_free(operation->context);
+    mbedtls_platform_zeroize(operation, sizeof(*operation));
+    return PSA_SUCCESS;
+}
+
+#endif /* MBEDTLS_PSA_CRYPTO_C && MBEDTLS_PSA_BUILTIN_ALG_SPAKE2P */
diff --git a/drivers/builtin/src/psa_crypto_spake2p.h b/drivers/builtin/src/psa_crypto_spake2p.h
new file mode 100644
index 0000000..dedb371
--- /dev/null
+++ b/drivers/builtin/src/psa_crypto_spake2p.h
@@ -0,0 +1,79 @@
+/*
+ *  SPAKE2+ Matter built-in PAKE engine
+ */
+/*
+ *  Copyright The Mbed TLS Contributors
+ *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later
+ */
+
+#ifndef TF_PSA_CRYPTO_PSA_CRYPTO_SPAKE2P_H
+#define TF_PSA_CRYPTO_PSA_CRYPTO_SPAKE2P_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "psa/crypto_types.h"
+
+struct psa_crypto_driver_pake_inputs_s;
+
+#define MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES 32u
+#define MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES 65u
+#define MBEDTLS_PSA_SPAKE2P_P256_KEYPAIR_BYTES \
+    (2u * MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES)
+#define MBEDTLS_PSA_SPAKE2P_P256_PUBLIC_BYTES \
+    (MBEDTLS_PSA_SPAKE2P_P256_SCALAR_BYTES + \
+     MBEDTLS_PSA_SPAKE2P_P256_POINT_BYTES)
+#define MBEDTLS_PSA_SPAKE2P_CONFIRM_BYTES 32u
+#define MBEDTLS_PSA_SPAKE2P_SHARED_KEY_BYTES 32u
+
+typedef enum {
+    MBEDTLS_PSA_SPAKE2P_STATE_INIT = 0,
+    MBEDTLS_PSA_SPAKE2P_STATE_READY,
+    MBEDTLS_PSA_SPAKE2P_STATE_ERROR
+} mbedtls_psa_spake2p_state_t;
+
+typedef struct {
+    psa_algorithm_t MBEDTLS_PRIVATE(alg);
+    psa_key_type_t MBEDTLS_PRIVATE(key_type);
+    uint8_t MBEDTLS_PRIVATE(role);
+    mbedtls_psa_spake2p_state_t MBEDTLS_PRIVATE(state);
+
+    uint8_t MBEDTLS_PRIVATE(key)[MBEDTLS_PSA_SPAKE2P_P256_PUBLIC_BYTES];
+    size_t MBEDTLS_PRIVATE(key_len);
+
+    uint8_t *MBEDTLS_PRIVATE(user);
+    size_t MBEDTLS_PRIVATE(user_len);
+    uint8_t *MBEDTLS_PRIVATE(peer);
+    size_t MBEDTLS_PRIVATE(peer_len);
+    uint8_t *MBEDTLS_PRIVATE(context);
+    size_t MBEDTLS_PRIVATE(context_len);
+    unsigned MBEDTLS_PRIVATE(context_is_set) : 1;
+} mbedtls_psa_spake2p_operation_t;
+
+psa_status_t mbedtls_psa_spake2p_setup(
+    mbedtls_psa_spake2p_operation_t *operation,
+    const struct psa_crypto_driver_pake_inputs_s *inputs);
+
+psa_status_t mbedtls_psa_spake2p_output(
+    mbedtls_psa_spake2p_operation_t *operation,
+    int step,
+    uint8_t *output,
+    size_t output_size,
+    size_t *output_length);
+
+psa_status_t mbedtls_psa_spake2p_input(
+    mbedtls_psa_spake2p_operation_t *operation,
+    int step,
+    const uint8_t *input,
+    size_t input_length);
+
+psa_status_t mbedtls_psa_spake2p_get_shared_key(
+    mbedtls_psa_spake2p_operation_t *operation,
+    uint8_t *output,
+    size_t output_size,
+    size_t *output_length);
+
+psa_status_t mbedtls_psa_spake2p_abort(
+    mbedtls_psa_spake2p_operation_t *operation);
+
+#endif /* TF_PSA_CRYPTO_PSA_CRYPTO_SPAKE2P_H */
diff --git a/drivers/builtin/src/psa_crypto_spake2p_ecp.c b/drivers/builtin/src/psa_crypto_spake2p_ecp.c
new file mode 100644
index 0000000..ad34d0d
--- /dev/null
+++ b/drivers/builtin/src/psa_crypto_spake2p_ecp.c
@@ -0,0 +1,266 @@
+/*
+ *  Private ECC helpers for SPAKE2+ Matter
+ */
+/*
+ *  Copyright The Mbed TLS Contributors
+ *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later
+ */
+
+#include "tf_psa_crypto_common.h"
+
+#if defined(MBEDTLS_PSA_CRYPTO_C) && defined(MBEDTLS_PSA_BUILTIN_ALG_SPAKE2P)
+
+#include "psa_crypto_spake2p_ecp.h"
+#include "psa_util_internal.h"
+
+#include "mbedtls/constant_time.h"
+#include "mbedtls/private/error_common.h"
+
+static psa_status_t mbedtls_psa_spake2p_ecp_status(int ret)
+{
+    if (ret == 0) {
+        return PSA_SUCCESS;
+    }
+
+    switch (ret) {
+        case MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL:
+            return PSA_ERROR_BUFFER_TOO_SMALL;
+        case MBEDTLS_ERR_MPI_ALLOC_FAILED:
+            return PSA_ERROR_INSUFFICIENT_MEMORY;
+        case MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE:
+            return PSA_ERROR_NOT_SUPPORTED;
+        case MBEDTLS_ERR_ECP_INVALID_KEY:
+        case MBEDTLS_ERR_MPI_BAD_INPUT_DATA:
+            return PSA_ERROR_INVALID_ARGUMENT;
+        default:
+            return PSA_ERROR_CORRUPTION_DETECTED;
+    }
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_load_group(
+    mbedtls_ecp_group *grp,
+    psa_ecc_family_t family,
+    size_t bits)
+{
+    if (grp == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    if (family != PSA_ECC_FAMILY_SECP_R1 || bits != 256) {
+        return PSA_ERROR_NOT_SUPPORTED;
+    }
+
+    return mbedtls_psa_spake2p_ecp_status(
+        mbedtls_ecp_group_load(grp, MBEDTLS_ECP_DP_SECP256R1));
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_read_scalar(
+    const mbedtls_ecp_group *grp,
+    mbedtls_mpi *k,
+    const uint8_t *input,
+    size_t input_length)
+{
+    int ret;
+
+    if (grp == NULL || k == NULL || input == NULL || input_length == 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    ret = mbedtls_mpi_read_binary(k, input, input_length);
+    if (ret != 0) {
+        return mbedtls_psa_spake2p_ecp_status(ret);
+    }
+
+    if (mbedtls_mpi_cmp_int(k, 0) <= 0 ||
+        mbedtls_mpi_cmp_mpi(k, &grp->N) >= 0) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    return PSA_SUCCESS;
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_write_scalar(
+    const mbedtls_ecp_group *grp,
+    const mbedtls_mpi *k,
+    uint8_t *output,
+    size_t output_size,
+    size_t *output_length)
+{
+    size_t olen;
+    int ret;
+
+    if (grp == NULL || k == NULL || output_length == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    olen = PSA_BITS_TO_BYTES(grp->pbits);
+    if (output_size < olen) {
+        return PSA_ERROR_BUFFER_TOO_SMALL;
+    }
+
+    ret = mbedtls_mpi_write_binary(k, output, olen);
+    if (ret != 0) {
+        return mbedtls_psa_spake2p_ecp_status(ret);
+    }
+
+    *output_length = olen;
+    return PSA_SUCCESS;
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_validate_point(
+    const mbedtls_ecp_group *grp,
+    const mbedtls_ecp_point *P)
+{
+    if (grp == NULL || P == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    return mbedtls_psa_spake2p_ecp_status(
+        mbedtls_ecp_check_pubkey(grp, P));
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_import_point(
+    const mbedtls_ecp_group *grp,
+    mbedtls_ecp_point *P,
+    const uint8_t *input,
+    size_t input_length)
+{
+    psa_status_t status;
+    int ret;
+
+    if (grp == NULL || P == NULL || input == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    ret = mbedtls_ecp_point_read_binary(grp, P, input, input_length);
+    if (ret != 0) {
+        return mbedtls_psa_spake2p_ecp_status(ret);
+    }
+
+    status = mbedtls_psa_spake2p_ecp_validate_point(grp, P);
+    if (status != PSA_SUCCESS) {
+        return status;
+    }
+
+    /* P-256 has cofactor 1, so mbedtls_ecp_check_pubkey() is sufficient for
+     * the initial Matter-only profile. The helper boundary keeps the future
+     * subgroup policy explicit if non-prime-order groups are added later. */
+    return PSA_SUCCESS;
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_export_point(
+    const mbedtls_ecp_group *grp,
+    const mbedtls_ecp_point *P,
+    uint8_t *output,
+    size_t output_size,
+    size_t *output_length)
+{
+    int ret;
+
+    if (grp == NULL || P == NULL || output_length == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    ret = mbedtls_ecp_point_write_binary(grp, P,
+                                         MBEDTLS_ECP_PF_UNCOMPRESSED,
+                                         output_length,
+                                         output, output_size);
+    return mbedtls_psa_spake2p_ecp_status(ret);
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_mul(
+    const mbedtls_ecp_group *grp,
+    mbedtls_ecp_point *R,
+    const mbedtls_mpi *k,
+    const mbedtls_ecp_point *P)
+{
+    if (grp == NULL || R == NULL || k == NULL || P == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    return mbedtls_psa_spake2p_ecp_status(
+        mbedtls_ecp_mul((mbedtls_ecp_group *) grp, R, k, P,
+                        mbedtls_psa_get_random, MBEDTLS_PSA_RANDOM_STATE));
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_mul_base(
+    const mbedtls_ecp_group *grp,
+    mbedtls_ecp_point *R,
+    const mbedtls_mpi *k)
+{
+    if (grp == NULL || R == NULL || k == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    return mbedtls_psa_spake2p_ecp_mul(grp, R, k, &grp->G);
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_add(
+    const mbedtls_ecp_group *grp,
+    mbedtls_ecp_point *R,
+    const mbedtls_ecp_point *P,
+    const mbedtls_ecp_point *Q)
+{
+    mbedtls_mpi one;
+    psa_status_t status;
+    int ret;
+
+    if (grp == NULL || R == NULL || P == NULL || Q == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    mbedtls_mpi_init(&one);
+    ret = mbedtls_mpi_lset(&one, 1);
+    if (ret == 0) {
+        ret = mbedtls_ecp_muladd((mbedtls_ecp_group *) grp, R,
+                                 &one, P, &one, Q);
+    }
+    status = mbedtls_psa_spake2p_ecp_status(ret);
+    mbedtls_mpi_free(&one);
+
+    return status;
+}
+
+psa_status_t mbedtls_psa_spake2p_ecp_sub(
+    const mbedtls_ecp_group *grp,
+    mbedtls_ecp_point *R,
+    const mbedtls_ecp_point *P,
+    const mbedtls_ecp_point *Q)
+{
+    mbedtls_mpi one;
+    mbedtls_mpi minus_one;
+    psa_status_t status;
+    int ret;
+
+    if (grp == NULL || R == NULL || P == NULL || Q == NULL) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    mbedtls_mpi_init(&one);
+    mbedtls_mpi_init(&minus_one);
+
+    ret = mbedtls_mpi_lset(&one, 1);
+    if (ret == 0) {
+        ret = mbedtls_mpi_sub_int(&minus_one, &grp->N, 1);
+    }
+    if (ret == 0) {
+        ret = mbedtls_ecp_muladd((mbedtls_ecp_group *) grp, R,
+                                 &one, P, &minus_one, Q);
+    }
+
+    status = mbedtls_psa_spake2p_ecp_status(ret);
+    mbedtls_mpi_free(&one);
+    mbedtls_mpi_free(&minus_one);
+
+    return status;
+}
+
+int mbedtls_psa_spake2p_ct_memcmp(
+    const uint8_t *a,
+    const uint8_t *b,
+    size_t len)
+{
+    return mbedtls_ct_memcmp(a, b, len);
+}

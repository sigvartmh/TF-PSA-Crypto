+{
+#if defined(MBEDTLS_TEST_HOOKS)
+    psa_key_id_t client_key = MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_id_t server_key = MBEDTLS_SVC_KEY_ID_INIT;
+    psa_pake_operation_t client = PSA_PAKE_OPERATION_INIT;
+    psa_pake_operation_t server = PSA_PAKE_OPERATION_INIT;
+    uint8_t share_p[SPAKE2P_P256_POINT_BYTES];
+    uint8_t share_v[SPAKE2P_P256_POINT_BYTES];
+    uint8_t confirm_v[SPAKE2P_CONFIRM_BYTES];
+    size_t output_length = 0;
+    psa_status_t status;
+
+    PSA_ASSERT( psa_crypto_init() );
+    PSA_ASSERT( spake2p_matter_import_keypair(&client_key) );
+    PSA_ASSERT( spake2p_matter_import_keypair(&server_key) );
+    PSA_ASSERT( spake2p_matter_setup_party(
+        &client, client_key, PSA_PAKE_ROLE_CLIENT,
+        spake2p_matter_client_id, sizeof(spake2p_matter_client_id),
+        spake2p_matter_server_id, sizeof(spake2p_matter_server_id),
+        spake2p_matter_context, sizeof(spake2p_matter_context)) );
+    PSA_ASSERT( spake2p_matter_setup_party(
+        &server, server_key, PSA_PAKE_ROLE_SERVER,
+        spake2p_matter_server_id, sizeof(spake2p_matter_server_id),
+        spake2p_matter_client_id, sizeof(spake2p_matter_client_id),
+        spake2p_matter_bad_context, sizeof(spake2p_matter_bad_context)) );
+
+    PSA_ASSERT( mbedtls_psa_spake2p_test_set_next_scalar(
+        spake2p_matter_client_scalar) );
+    PSA_ASSERT( psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
+                                share_p, sizeof(share_p), &output_length) );
+    PSA_ASSERT( psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE,
+                               share_p, output_length) );
+    PSA_ASSERT( mbedtls_psa_spake2p_test_set_next_scalar(
+        spake2p_matter_server_scalar) );
+    PSA_ASSERT( psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
+                                share_v, sizeof(share_v), &output_length) );
+    PSA_ASSERT( psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
+                                confirm_v, sizeof(confirm_v),
+                                &output_length) );
+    PSA_ASSERT( psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE,
+                               share_v, sizeof(share_v)) );
+
+    status = psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM,
+                            confirm_v, sizeof(confirm_v));
+    TEST_EQUAL(PSA_ERROR_INVALID_SIGNATURE, status);
+
+exit:
+    psa_destroy_key(client_key);
+    psa_destroy_key(server_key);
+    psa_pake_abort(&client);
+    psa_pake_abort(&server);
+#else
+    TEST_ASSERT(0);
+#endif
+}
+/* END_CASE */
+
+/* BEGIN_CASE */
+void spake2p_matter_swapped_identities_rejected( void )
+{
+#if defined(MBEDTLS_TEST_HOOKS)
+    psa_key_id_t client_key = MBEDTLS_SVC_KEY_ID_INIT;
+    psa_key_id_t server_key = MBEDTLS_SVC_KEY_ID_INIT;
+    psa_pake_operation_t client = PSA_PAKE_OPERATION_INIT;
+    psa_pake_operation_t server = PSA_PAKE_OPERATION_INIT;
+    uint8_t share_p[SPAKE2P_P256_POINT_BYTES];
+    uint8_t share_v[SPAKE2P_P256_POINT_BYTES];
+    uint8_t confirm_v[SPAKE2P_CONFIRM_BYTES];
+    size_t output_length = 0;
+    psa_status_t status;
+
+    PSA_ASSERT( psa_crypto_init() );
+    PSA_ASSERT( spake2p_matter_import_keypair(&client_key) );
+    PSA_ASSERT( spake2p_matter_import_keypair(&server_key) );
+    PSA_ASSERT( spake2p_matter_setup_party(
+        &client, client_key, PSA_PAKE_ROLE_CLIENT,
+        spake2p_matter_client_id, sizeof(spake2p_matter_client_id),
+        spake2p_matter_server_id, sizeof(spake2p_matter_server_id),
+        spake2p_matter_context, sizeof(spake2p_matter_context)) );
+    PSA_ASSERT( spake2p_matter_setup_party(
+        &server, server_key, PSA_PAKE_ROLE_SERVER,
+        spake2p_matter_client_id, sizeof(spake2p_matter_client_id),
+        spake2p_matter_server_id, sizeof(spake2p_matter_server_id),
+        spake2p_matter_context, sizeof(spake2p_matter_context)) );
+
+    PSA_ASSERT( mbedtls_psa_spake2p_test_set_next_scalar(
+        spake2p_matter_client_scalar) );
+    PSA_ASSERT( psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
+                                share_p, sizeof(share_p), &output_length) );
+    PSA_ASSERT( psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE,

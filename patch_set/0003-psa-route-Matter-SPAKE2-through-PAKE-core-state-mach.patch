 {
-    (void) operation;
-    (void) context;
-    (void) context_len;
-    return PSA_ERROR_NOT_SUPPORTED;
+    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
+    LOCAL_INPUT_DECLARE(context_external, context);
+
+    if (operation->stage != PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS) {
+        status = PSA_ERROR_BAD_STATE;
+        goto exit;
+    }
+
+#if defined(PSA_WANT_ALG_SPAKE2P_MATTER)
+    if (operation->alg == PSA_ALG_SPAKE2P_MATTER) {
+        if ((operation->data.inputs.flags &
+             PSA_CRYPTO_DRIVER_PAKE_INPUT_HAS_CONTEXT) != 0) {
+            status = PSA_ERROR_BAD_STATE;
+            goto exit;
+        }
+
+        if (context_len != 0) {
+            operation->data.inputs.context = mbedtls_calloc(1, context_len);
+            if (operation->data.inputs.context == NULL) {
+                status = PSA_ERROR_INSUFFICIENT_MEMORY;
+                goto exit;
+            }
+
+            LOCAL_INPUT_ALLOC(context_external, context_len, context);
+            memcpy(operation->data.inputs.context, context, context_len);
+        }
+        operation->data.inputs.context_len = context_len;
+        operation->data.inputs.flags |= PSA_CRYPTO_DRIVER_PAKE_INPUT_HAS_CONTEXT;
+        status = PSA_SUCCESS;
+    } else
+#endif /* PSA_WANT_ALG_SPAKE2P_MATTER */
+    {
+        (void) context_len;
+        status = PSA_ERROR_NOT_SUPPORTED;
+    }
+
+exit:
+    LOCAL_INPUT_FREE(context_external, context);
+    if (status != PSA_SUCCESS) {
+        psa_pake_abort(operation);

         {
             status = PSA_ERROR_NOT_SUPPORTED;
         }
@@ -9481,6 +9604,115 @@ static psa_status_t psa_jpake_epilogue(
 
 #endif /* PSA_WANT_ALG_JPAKE */
 
+#if defined(PSA_WANT_ALG_SPAKE2P_MATTER)
+static psa_status_t psa_spake2p_prologue(
+    psa_pake_operation_t *operation,
+    psa_pake_step_t step,
+    psa_jpake_io_mode_t io_mode,
+    psa_crypto_driver_pake_step_t *driver_step)
+{
+    psa_spake2p_computation_stage_t *stage =
+        &operation->computation_stage.spake2p;
+
+    if (step != PSA_PAKE_STEP_KEY_SHARE &&
+        step != PSA_PAKE_STEP_CONFIRM) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    if (stage->role == PSA_PAKE_ROLE_CLIENT) {
+        if (io_mode == PSA_JPAKE_OUTPUT &&
+            step == PSA_PAKE_STEP_KEY_SHARE &&
+            stage->phase == PSA_SPAKE2P_PHASE_INIT) {
+            *driver_step = PSA_SPAKE2P_STEP_KEY_SHARE;
+            return PSA_SUCCESS;
+        }
+        if (io_mode == PSA_JPAKE_INPUT &&
+            step == PSA_PAKE_STEP_KEY_SHARE &&
+            stage->phase == PSA_SPAKE2P_PHASE_CLIENT_EXPECT_PEER_SHARE) {
+            *driver_step = PSA_SPAKE2P_STEP_KEY_SHARE;
+            return PSA_SUCCESS;
+        }
+        if (io_mode == PSA_JPAKE_INPUT &&
+            step == PSA_PAKE_STEP_CONFIRM &&
+            stage->phase == PSA_SPAKE2P_PHASE_CLIENT_EXPECT_PEER_CONFIRM) {
+            *driver_step = PSA_SPAKE2P_STEP_CONFIRM;
+            return PSA_SUCCESS;
+        }
+        if (io_mode == PSA_JPAKE_OUTPUT &&
+            step == PSA_PAKE_STEP_CONFIRM &&
+            stage->phase == PSA_SPAKE2P_PHASE_CLIENT_EXPECT_OWN_CONFIRM) {
+            *driver_step = PSA_SPAKE2P_STEP_CONFIRM;
+            return PSA_SUCCESS;
+        }
+    } else if (stage->role == PSA_PAKE_ROLE_SERVER) {
+        if (io_mode == PSA_JPAKE_INPUT &&
+            step == PSA_PAKE_STEP_KEY_SHARE &&
+            stage->phase == PSA_SPAKE2P_PHASE_SERVER_EXPECT_PEER_SHARE) {
+            *driver_step = PSA_SPAKE2P_STEP_KEY_SHARE;
+            return PSA_SUCCESS;
+        }
+        if (io_mode == PSA_JPAKE_OUTPUT &&
+            step == PSA_PAKE_STEP_KEY_SHARE &&
+            stage->phase == PSA_SPAKE2P_PHASE_SERVER_EXPECT_OWN_SHARE) {
+            *driver_step = PSA_SPAKE2P_STEP_KEY_SHARE;
+            return PSA_SUCCESS;
+        }
+        if (io_mode == PSA_JPAKE_OUTPUT &&
+            step == PSA_PAKE_STEP_CONFIRM &&
+            stage->phase == PSA_SPAKE2P_PHASE_SERVER_EXPECT_OWN_CONFIRM) {
+            *driver_step = PSA_SPAKE2P_STEP_CONFIRM;
+            return PSA_SUCCESS;
+        }
+        if (io_mode == PSA_JPAKE_INPUT &&
+            step == PSA_PAKE_STEP_CONFIRM &&
+            stage->phase == PSA_SPAKE2P_PHASE_SERVER_EXPECT_PEER_CONFIRM) {
+            *driver_step = PSA_SPAKE2P_STEP_CONFIRM;
+            return PSA_SUCCESS;
+        }
+    }
+
+    return PSA_ERROR_BAD_STATE;
+}
+
+static void psa_spake2p_epilogue(
+    psa_pake_operation_t *operation,
+    psa_jpake_io_mode_t io_mode)
+{
+    psa_spake2p_computation_stage_t *stage =
+        &operation->computation_stage.spake2p;
+
+    if (stage->role == PSA_PAKE_ROLE_CLIENT) {
+        if (io_mode == PSA_JPAKE_OUTPUT &&
+            stage->phase == PSA_SPAKE2P_PHASE_INIT) {
+            stage->phase = PSA_SPAKE2P_PHASE_CLIENT_EXPECT_PEER_SHARE;
+        } else if (io_mode == PSA_JPAKE_INPUT &&
+                   stage->phase == PSA_SPAKE2P_PHASE_CLIENT_EXPECT_PEER_SHARE) {
+            stage->phase = PSA_SPAKE2P_PHASE_CLIENT_EXPECT_PEER_CONFIRM;
+        } else if (io_mode == PSA_JPAKE_INPUT &&
+                   stage->phase == PSA_SPAKE2P_PHASE_CLIENT_EXPECT_PEER_CONFIRM) {
+            stage->phase = PSA_SPAKE2P_PHASE_CLIENT_EXPECT_OWN_CONFIRM;
+        } else if (io_mode == PSA_JPAKE_OUTPUT &&
+                   stage->phase == PSA_SPAKE2P_PHASE_CLIENT_EXPECT_OWN_CONFIRM) {
+            stage->phase = PSA_SPAKE2P_PHASE_FINISHED;
+        }
+    } else if (stage->role == PSA_PAKE_ROLE_SERVER) {
+        if (io_mode == PSA_JPAKE_INPUT &&
+            stage->phase == PSA_SPAKE2P_PHASE_SERVER_EXPECT_PEER_SHARE) {
+            stage->phase = PSA_SPAKE2P_PHASE_SERVER_EXPECT_OWN_SHARE;
+        } else if (io_mode == PSA_JPAKE_OUTPUT &&
+                   stage->phase == PSA_SPAKE2P_PHASE_SERVER_EXPECT_OWN_SHARE) {
+            stage->phase = PSA_SPAKE2P_PHASE_SERVER_EXPECT_OWN_CONFIRM;
+        } else if (io_mode == PSA_JPAKE_OUTPUT &&
+                   stage->phase == PSA_SPAKE2P_PHASE_SERVER_EXPECT_OWN_CONFIRM) {
+            stage->phase = PSA_SPAKE2P_PHASE_SERVER_EXPECT_PEER_CONFIRM;
+        } else if (io_mode == PSA_JPAKE_INPUT &&
+                   stage->phase == PSA_SPAKE2P_PHASE_SERVER_EXPECT_PEER_CONFIRM) {
+            stage->phase = PSA_SPAKE2P_PHASE_FINISHED;
+        }
+    }
+}
+#endif /* PSA_WANT_ALG_SPAKE2P_MATTER */

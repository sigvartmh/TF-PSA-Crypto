+    } else
+#endif /* PSA_WANT_ALG_SPAKE2P_MATTER */
     {
         status = PSA_ERROR_NOT_SUPPORTED;
         goto exit;
@@ -9655,6 +9915,16 @@ psa_status_t psa_pake_get_shared_key(psa_pake_operation_t *operation,
         }
     } else
 #endif /* PSA_WANT_ALG_JPAKE */

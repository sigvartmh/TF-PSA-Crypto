+    } else
+#endif /* PSA_WANT_ALG_SPAKE2P_MATTER */
     {
         (void) step;
         status = PSA_ERROR_NOT_SUPPORTED;
@@ -9543,6 +9784,11 @@ psa_status_t psa_pake_output(
         }
     } else
 #endif /* PSA_WANT_ALG_JPAKE */
+#if defined(PSA_WANT_ALG_SPAKE2P_MATTER)
+    if (operation->alg == PSA_ALG_SPAKE2P_MATTER) {
+        psa_spake2p_epilogue(operation, PSA_JPAKE_OUTPUT);
+    } else
+#endif /* PSA_WANT_ALG_SPAKE2P_MATTER */
     {
         status = PSA_ERROR_NOT_SUPPORTED;
         goto exit;
@@ -9596,6 +9842,15 @@ psa_status_t psa_pake_input(
             &operation->computation_stage.jpake);
     } else
 #endif /* PSA_WANT_ALG_JPAKE */
+#if defined(PSA_WANT_ALG_SPAKE2P_MATTER)
+    if (operation->alg == PSA_ALG_SPAKE2P_MATTER) {
+        status = psa_spake2p_prologue(operation, step, PSA_JPAKE_INPUT,
+                                      &driver_step);
+        if (status != PSA_SUCCESS) {
+            goto exit;
+        }
+    } else
+#endif /* PSA_WANT_ALG_SPAKE2P_MATTER */
     {
         (void) step;
         status = PSA_ERROR_NOT_SUPPORTED;
@@ -9618,6 +9873,11 @@ psa_status_t psa_pake_input(
         }
     } else
 #endif /* PSA_WANT_ALG_JPAKE */
+#if defined(PSA_WANT_ALG_SPAKE2P_MATTER)

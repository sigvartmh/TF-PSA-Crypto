     /* Driver is responsible for creating its own copy of the password. */
     mbedtls_zeroize_and_free(inputs.password, inputs.password_len);
+    mbedtls_zeroize_and_free(inputs.key, inputs.key_len);
 
-    /* User and peer are translated to role. */
+    /* The driver is responsible for copying user, peer and context as needed. */
     mbedtls_free(inputs.user);
     mbedtls_free(inputs.peer);
+    mbedtls_free(inputs.context);
 
     if (status == PSA_SUCCESS) {
 #if defined(PSA_WANT_ALG_JPAKE)
@@ -9397,6 +9515,11 @@ static psa_status_t psa_pake_complete_inputs(
             operation->stage = PSA_PAKE_OPERATION_STAGE_COMPUTATION;
         } else
 #endif /* PSA_WANT_ALG_JPAKE */
+#if defined(PSA_WANT_ALG_SPAKE2P_MATTER)

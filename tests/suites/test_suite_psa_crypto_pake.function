/* BEGIN_CASE */
void pake_set_context(int alg_arg, data_t *context_arg,
                    int out_of_order, int repeated_call, int null_with_len,
                    int expected_status)
{
    psa_pake_operation_t client = psa_pake_operation_init();
    psa_algorithm_t alg = alg_arg;
    const uint8_t *context = context_arg->x;
    size_t context_len = context_arg->len;
    client.alg = alg;
    client.data.inputs.context = NULL;
    client.data.inputs.context_len = 0;
    client.data.inputs.password = NULL;
    client.data.inputs.password_len = 0;
    client.data.inputs.user = NULL;
    client.data.inputs.peer = NULL;
    client.data.inputs.user_len = 0;
    client.data.inputs.peer_len = 0;
    client.data.inputs.attributes = psa_key_attributes_init();
    client.data.inputs.cipher_suite = psa_pake_cipher_suite_init();

    PSA_INIT();

    if (null_with_len == 1) {
        /* A NULL context pointer with a non-zero length must be rejected. */
        client.stage = PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS;
        TEST_EQUAL(psa_pake_set_context(&client, NULL, 8),
                   expected_status);
    } else if (out_of_order == 1) {
        TEST_EQUAL(psa_pake_set_context(&client, context, context_len),
                   expected_status);
    } else if (repeated_call == 1) {
        client.stage = PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS;
        TEST_EQUAL(psa_pake_set_context(&client, context, context_len),
                    PSA_SUCCESS);
        /* The first call must have stored the context verbatim. */
        TEST_MEMORY_COMPARE(client.data.inputs.context,
                            client.data.inputs.context_len,
                            context, context_len);
        TEST_EQUAL(psa_pake_set_context(&client, context, context_len),
                    expected_status);
    } else {
        client.stage = PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS;
        TEST_EQUAL(psa_pake_set_context(&client, context, context_len),
                    expected_status);
        /* On success the context must be stored verbatim. */
        if (expected_status == PSA_SUCCESS) {
            TEST_MEMORY_COMPARE(client.data.inputs.context,
                                client.data.inputs.context_len,
                                context, context_len);
        }
    }

exit:
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_rounds(int alg_arg, int bits_arg,
                    data_t *client_key, data_t *server_key,
                    int use_context)
{
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    psa_key_attributes_t ka = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t client_ss = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t server_ss = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t cbuf[PSA_HASH_MAX_SIZE], sbuf[PSA_HASH_MAX_SIZE];
    size_t clen = 0, slen = 0;
    static const uint8_t context[] = { 'P', 'A', 'K', 'E', ' ', 'c', 't', 'x' };

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, (uint32_t) bits_arg,
                                   client_key, server_key,
                                   use_context ? context : NULL,
                                   use_context ? sizeof(context) : 0) == 1);

    TEST_ASSERT(spake2p_do_exchange(&server, &client) == 1);

    /* Both parties export the shared secret as raw key-derivation input. */
    psa_set_key_usage_flags(&ka, PSA_KEY_USAGE_EXPORT);
    psa_set_key_type(&ka, PSA_KEY_TYPE_DERIVE);
    psa_set_key_algorithm(&ka, PSA_ALG_HKDF(PSA_ALG_SHA_256));

    PSA_ASSERT(psa_pake_get_shared_key(&client, &ka, &client_ss));
    PSA_ASSERT(psa_pake_get_shared_key(&server, &ka, &server_ss));

    PSA_ASSERT(psa_export_key(client_ss, cbuf, sizeof(cbuf), &clen));
    PSA_ASSERT(psa_export_key(server_ss, sbuf, sizeof(sbuf), &slen));

    TEST_ASSERT(clen > 0);
    TEST_MEMORY_COMPARE(cbuf, clen, sbuf, slen);

exit:
    psa_destroy_key(client_ss);
    psa_destroy_key(server_ss);
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_MATTER:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256:MBEDTLS_TEST_HOOKS */
void spake2p_psa_matter_kat(data_t *context,
                            data_t *client_key, data_t *server_key,
                            data_t *x, data_t *y,
                            data_t *exp_shareP, data_t *exp_shareV,
                            data_t *exp_confirmV, data_t *exp_confirmP,
                            data_t *exp_shared)
{
    /* PSA_ALG_SPAKE2P_MATTER is the HMAC-SHA-256 / P-256 ciphersuite with the
     * Matter / draft-bar-cfrg-spake2plus-02 key schedule (split digest, shared
     * secret = Ke). This drives the full PSA plumbing against the deterministic
     * Matter interop vector (tests/data_files/spake2p_matter_p256_interop.txt),
     * reproducing shareP, shareV, the confirmation MACs and K_shared
     * byte-for-byte with the ephemerals pinned via the test injection seam. */
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    psa_key_attributes_t ka = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t client_ss = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t server_ss = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t cbuf[PSA_HASH_MAX_SIZE], sbuf[PSA_HASH_MAX_SIZE];
    size_t lp = 0, lv = 0, lc = 0, clen = 0, slen = 0;

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_pair(&client, &server, PSA_ALG_SPAKE2P_MATTER, 256,
                                   client_key, server_key,
                                   context->x, context->len) == 1);

    /* Client KEY_SHARE = shareP, with the published ephemeral x. */
    mbedtls_spake2p_test_injected_ephemeral = x->x;
    mbedtls_spake2p_test_injected_ephemeral_len = x->len;
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    TEST_MEMORY_COMPARE(shareP, lp, exp_shareP->x, exp_shareP->len);
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));

    /* Server KEY_SHARE = shareV, with the published ephemeral y. */
    mbedtls_spake2p_test_injected_ephemeral = y->x;
    mbedtls_spake2p_test_injected_ephemeral_len = y->len;
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    TEST_MEMORY_COMPARE(shareV, lv, exp_shareV->x, exp_shareV->len);
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE, shareV, lv));

    /* Confirmation exchange: the Verifier (server) confirms first. */
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    TEST_MEMORY_COMPARE(confirm, lc, exp_confirmV->x, exp_confirmV->len);
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM, confirm, lc));

    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    TEST_MEMORY_COMPARE(confirm, lc, exp_confirmP->x, exp_confirmP->len);
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_CONFIRM, confirm, lc));

    /* Both parties derive the vector's K_shared. */
    psa_set_key_usage_flags(&ka, PSA_KEY_USAGE_EXPORT);
    psa_set_key_type(&ka, PSA_KEY_TYPE_DERIVE);
    psa_set_key_algorithm(&ka, PSA_ALG_HKDF(PSA_ALG_SHA_256));

    PSA_ASSERT(psa_pake_get_shared_key(&client, &ka, &client_ss));
    PSA_ASSERT(psa_pake_get_shared_key(&server, &ka, &server_ss));
    PSA_ASSERT(psa_export_key(client_ss, cbuf, sizeof(cbuf), &clen));
    PSA_ASSERT(psa_export_key(server_ss, sbuf, sizeof(sbuf), &slen));

    TEST_MEMORY_COMPARE(cbuf, clen, exp_shared->x, exp_shared->len);
    TEST_MEMORY_COMPARE(sbuf, slen, exp_shared->x, exp_shared->len);

exit:
    mbedtls_spake2p_test_injected_ephemeral = NULL;
    mbedtls_spake2p_test_injected_ephemeral_len = 0;
    psa_destroy_key(client_ss);
    psa_destroy_key(server_ss);
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_bad_confirm(int alg_arg, int bits_arg,
                         data_t *client_key, data_t *server_key)
{
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0, lv = 0, lc = 0;

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, (uint32_t) bits_arg,
                                   client_key, server_key, NULL, 0) == 1);

    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE, shareV, lv));

    /* Verifier produces confirmV; flip a bit before the Prover verifies it. */
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    confirm[0] ^= 0x01;
    TEST_EQUAL(psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM, confirm, lc),
               PSA_ERROR_INVALID_SIGNATURE);

exit:
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_bad_confirm_server(int alg_arg, int bits_arg,
                                data_t *client_key, data_t *server_key)
{
    /* Companion to spake2p_bad_confirm: exercise the Verifier (server) side of
     * key confirmation. A tampered Prover confirmation (confirmP) must be
     * rejected with PSA_ERROR_INVALID_SIGNATURE. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0, lv = 0, lc = 0;

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, (uint32_t) bits_arg,
                                   client_key, server_key, NULL, 0) == 1);

    /* Key share exchange. */
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE, shareV, lv));

    /* Verifier confirms first; deliver confirmV untouched so the Prover
     * proceeds to produce its own confirmation. */
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM, confirm, lc));

    /* Prover produces confirmP; flip a bit before the Verifier verifies it. */
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    confirm[0] ^= 0x01;
    TEST_EQUAL(psa_pake_input(&server, PSA_PAKE_STEP_CONFIRM, confirm, lc),
               PSA_ERROR_INVALID_SIGNATURE);

exit:
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_MATTER:PSA_WANT_ALG_SHA_256:PSA_WANT_ALG_HMAC */
void spake2p_matter_wrong_curve(int bits_arg, data_t *client_key)
{
    /* PSA_ALG_SPAKE2P_MATTER is the HMAC-SHA-256 profile pinned to P-256.
     * Setting it up on any other secp_r1 curve must be rejected. The builtin
     * reports this lazily when the driver is set up on the first output. */
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_key_attributes_t ca = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ckey = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, PSA_ALG_SPAKE2P_MATTER);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1,
                                                      (uint32_t) bits_arg));

    psa_set_key_usage_flags(&ca, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&ca, PSA_ALG_SPAKE2P_MATTER);
    psa_set_key_type(&ca, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&ca, client_key->x, client_key->len, &ckey));

    PSA_ASSERT(psa_pake_setup(&client, ckey, &cs));
    PSA_ASSERT(psa_pake_set_role(&client, PSA_PAKE_ROLE_CLIENT));
    PSA_ASSERT(psa_pake_set_user(&client, spake2p_client_id,
                                 sizeof(spake2p_client_id)));
    PSA_ASSERT(psa_pake_set_peer(&client, spake2p_server_id,
                                 sizeof(spake2p_server_id)));

    /* The curve/algorithm mismatch surfaces when the driver is set up, which
     * happens lazily on the first psa_pake_output(). */
    TEST_EQUAL(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp),
               PSA_ERROR_NOT_SUPPORTED);

exit:
    psa_destroy_key(ckey);
    psa_pake_abort(&client);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_bad_key_share(int alg_arg, int bits_arg,
                           data_t *client_key, data_t *server_key)
{
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, (uint32_t) bits_arg,
                                   client_key, server_key, NULL, 0) == 1);

    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    /* Corrupt the point so it is no longer on the curve. */
    shareP[lp - 1] ^= 0x01;
    TEST_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp) !=
                PSA_SUCCESS);

exit:
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SHA_256:PSA_WANT_ECC_SECP_R1_256 */
void spake2p_size_macros()
{
    psa_algorithm_t alg = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);
    psa_pake_primitive_t prim = PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                   PSA_ECC_FAMILY_SECP_R1, 256);

    /* P-256 uncompressed key share = 65 bytes; HMAC-SHA-256 confirm = 32. */
    TEST_EQUAL(PSA_PAKE_OUTPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE), 65);
    TEST_EQUAL(PSA_PAKE_INPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE), 65);
    TEST_EQUAL(PSA_PAKE_OUTPUT_SIZE(alg, prim, PSA_PAKE_STEP_CONFIRM), 32);
    TEST_EQUAL(PSA_PAKE_INPUT_SIZE(alg, prim, PSA_PAKE_STEP_CONFIRM), 32);

    TEST_ASSERT(PSA_PAKE_OUTPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE) <=
                PSA_PAKE_OUTPUT_MAX_SIZE);
    TEST_ASSERT(PSA_PAKE_INPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE) <=
                PSA_PAKE_INPUT_MAX_SIZE);

#if defined(PSA_WANT_ALG_SPAKE2P_CMAC)
    /* CMAC confirmation tag is 16 bytes regardless of hash. */
    TEST_EQUAL(PSA_PAKE_OUTPUT_SIZE(PSA_ALG_SPAKE2P_CMAC(PSA_ALG_SHA_256),
                                    prim, PSA_PAKE_STEP_CONFIRM), 16);
#endif
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_KEY_TYPE_SPAKE2P_KEY_PAIR_DERIVE:PSA_WANT_ALG_HKDF:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SHA_256:PSA_WANT_ALG_HMAC:PSA_WANT_ECC_SECP_R1_256 */
void spake2p_registration()
{
    /* SPAKE2+ registration (RFC 9383 Section 3.2, issue #9381): derive a key
     * pair (w0, w1) with psa_key_derivation_output_key(), then prove it is a
     * valid, self-consistent registration by running a full SPAKE2+ exchange
     * between the derived key pair and its exported verifier record (w0, L).
     * Re-deriving with the same inputs must give the same key (determinism). */
    static const uint8_t ikm[] = {
        0x70, 0x61, 0x73, 0x73, 0x77, 0x6f, 0x72, 0x64
    };
    mbedtls_svc_key_id_t kp1 = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t kp2 = MBEDTLS_SVC_KEY_ID_INIT;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    psa_key_attributes_t ka = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t client_ss = MBEDTLS_SVC_KEY_ID_INIT;
    mbedtls_svc_key_id_t server_ss = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t kp_buf[64], kp_buf2[64], pub_buf[97];
    uint8_t cbuf[PSA_HASH_MAX_SIZE], sbuf[PSA_HASH_MAX_SIZE];
    size_t kp_len = 0, kp_len2 = 0, pub_len = 0, clen = 0, slen = 0;
    data_t kp_data, pub_data;

    PSA_INIT();

    TEST_ASSERT(spake2p_derive_key_pair(&kp1, 256, ikm, sizeof(ikm)) == 1);

    /* The key pair is w0 || w1: two 32-byte scalars for P-256. */
    PSA_ASSERT(psa_export_key(kp1, kp_buf, sizeof(kp_buf), &kp_len));
    TEST_EQUAL(kp_len, 64);

    /* Determinism: the same inputs must derive the same key pair. */
    TEST_ASSERT(spake2p_derive_key_pair(&kp2, 256, ikm, sizeof(ikm)) == 1);
    PSA_ASSERT(psa_export_key(kp2, kp_buf2, sizeof(kp_buf2), &kp_len2));
    TEST_MEMORY_COMPARE(kp_buf, kp_len, kp_buf2, kp_len2);

    /* The verifier record w0 || L (97 bytes) shares its w0 with the key pair. */
    PSA_ASSERT(psa_export_public_key(kp1, pub_buf, sizeof(pub_buf), &pub_len));
    TEST_EQUAL(pub_len, 97);
    TEST_MEMORY_COMPARE(kp_buf, 32, pub_buf, 32);

    /* Run a full exchange with the derived registration material. */
    kp_data.x = kp_buf;
    kp_data.len = kp_len;
    pub_data.x = pub_buf;
    pub_data.len = pub_len;
    TEST_ASSERT(spake2p_setup_pair(&client, &server,
                                   PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256), 256,
                                   &kp_data, &pub_data, NULL, 0) == 1);
    TEST_ASSERT(spake2p_do_exchange(&server, &client) == 1);

    psa_set_key_usage_flags(&ka, PSA_KEY_USAGE_EXPORT);
    psa_set_key_type(&ka, PSA_KEY_TYPE_DERIVE);
    psa_set_key_algorithm(&ka, PSA_ALG_HKDF(PSA_ALG_SHA_256));
    PSA_ASSERT(psa_pake_get_shared_key(&client, &ka, &client_ss));
    PSA_ASSERT(psa_pake_get_shared_key(&server, &ka, &server_ss));
    PSA_ASSERT(psa_export_key(client_ss, cbuf, sizeof(cbuf), &clen));
    PSA_ASSERT(psa_export_key(server_ss, sbuf, sizeof(sbuf), &slen));
    TEST_ASSERT(clen > 0);
    TEST_MEMORY_COMPARE(cbuf, clen, sbuf, slen);

exit:
    psa_destroy_key(kp1);
    psa_destroy_key(kp2);
    psa_destroy_key(client_ss);
    psa_destroy_key(server_ss);
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */


/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_op_errors(int alg_arg, int bits_arg,
                       data_t *client_key, data_t *server_key)
{
    psa_algorithm_t alg = alg_arg;
    uint32_t bits = (uint32_t) bits_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    psa_key_attributes_t ka = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t ss = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t buf[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t olen = 0;
    static const uint8_t ctx[] = { 'c', 't', 'x' };

    psa_set_key_usage_flags(&ka, PSA_KEY_USAGE_DERIVE);
    psa_set_key_type(&ka, PSA_KEY_TYPE_DERIVE);
    psa_set_key_algorithm(&ka, PSA_ALG_HKDF(PSA_ALG_SHA_256));

    PSA_INIT();

    /* Error 1: get_shared_key before any exchange -> BAD_STATE. */
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, bits,
                                   client_key, server_key, NULL, 0) == 1);
    TEST_EQUAL(psa_pake_get_shared_key(&client, &ka, &ss), PSA_ERROR_BAD_STATE);
    psa_pake_abort(&client);
    psa_pake_abort(&server);

    /* Error 2: a CONFIRM step before the key share is exchanged -> BAD_STATE. */
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, bits,
                                   client_key, server_key, NULL, 0) == 1);
    TEST_EQUAL(psa_pake_output(&client, PSA_PAKE_STEP_CONFIRM,
                               buf, sizeof(buf), &olen),
               PSA_ERROR_BAD_STATE);
    psa_pake_abort(&client);
    psa_pake_abort(&server);

    /* Error 3: an unexpected step (ZK_PROOF is not a SPAKE2+ step) -> BAD_STATE. */
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, bits,
                                   client_key, server_key, NULL, 0) == 1);
    TEST_EQUAL(psa_pake_output(&client, PSA_PAKE_STEP_ZK_PROOF,
                               buf, sizeof(buf), &olen),
               PSA_ERROR_BAD_STATE);
    psa_pake_abort(&client);
    psa_pake_abort(&server);

    /* Error 4: set_context after leaving the input-collection stage -> BAD_STATE. */
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, bits,
                                   client_key, server_key, NULL, 0) == 1);
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               buf, sizeof(buf), &olen));
    TEST_EQUAL(psa_pake_set_context(&client, ctx, sizeof(ctx)),
               PSA_ERROR_BAD_STATE);
    psa_pake_abort(&client);
    psa_pake_abort(&server);

exit:
    psa_destroy_key(ss);
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_duplicate_step(int alg_arg, int bits_arg,
                            data_t *client_key, data_t *server_key)
{
    /* Each exchange (key share, then confirmation) transfers exactly one
     * message in each direction. A second call in the same direction within
     * one exchange must be rejected with PSA_ERROR_BAD_STATE, for both the
     * Prover (client) and the Verifier (server). */
    psa_algorithm_t alg = alg_arg;
    uint32_t bits = (uint32_t) bits_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0, lv = 0, lc = 0;

    PSA_INIT();

    /* Case 1: Verifier (server) emits its key share twice. */
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, bits,
                                   client_key, server_key, NULL, 0) == 1);
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    TEST_EQUAL(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv),
               PSA_ERROR_BAD_STATE);
    psa_pake_abort(&client);
    psa_pake_abort(&server);

    /* Case 2: Prover (client) emits its key share twice. */
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, bits,
                                   client_key, server_key, NULL, 0) == 1);
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    TEST_EQUAL(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp),
               PSA_ERROR_BAD_STATE);
    psa_pake_abort(&client);
    psa_pake_abort(&server);

    /* Case 3: Verifier (server) consumes the prover's key share twice. */
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, bits,
                                   client_key, server_key, NULL, 0) == 1);
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));
    TEST_EQUAL(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp),
               PSA_ERROR_BAD_STATE);
    psa_pake_abort(&client);
    psa_pake_abort(&server);

    /* Case 4: duplicate output in the confirmation exchange. */
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, bits,
                                   client_key, server_key, NULL, 0) == 1);
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE, shareV, lv));
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    TEST_EQUAL(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc),
               PSA_ERROR_BAD_STATE);

exit:
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_import_export(int alg_arg, int bits_arg, int is_public,
                           data_t *key_data)
{
    psa_algorithm_t alg = alg_arg;
    size_t bits = (size_t) bits_arg;
    psa_key_type_t type = is_public ?
                          PSA_KEY_TYPE_SPAKE2P_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1) :
                          PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1);
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    psa_key_attributes_t got = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;
    uint8_t out[PSA_EXPORT_KEY_OUTPUT_SIZE(
                    PSA_KEY_TYPE_SPAKE2P_PUBLIC_KEY(PSA_ECC_FAMILY_SECP_R1), 521)];
    size_t olen = 0;

    PSA_INIT();

    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_EXPORT);
    psa_set_key_algorithm(&attr, alg);
    psa_set_key_type(&attr, type);
    PSA_ASSERT(psa_import_key(&attr, key_data->x, key_data->len, &key));

    /* The reported key size is the curve size, not the serialized length. */
    PSA_ASSERT(psa_get_key_attributes(key, &got));
    TEST_EQUAL(psa_get_key_bits(&got), bits);

    /* The export-size macro must be large enough, and export must round-trip. */
    TEST_ASSERT(PSA_EXPORT_KEY_OUTPUT_SIZE(type, bits) >= key_data->len);
    TEST_ASSERT(sizeof(out) >= key_data->len);
    PSA_ASSERT(psa_export_key(key, out, sizeof(out), &olen));
    TEST_MEMORY_COMPARE(out, olen, key_data->x, key_data->len);

exit:
    psa_reset_key_attributes(&got);
    psa_destroy_key(key);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_confirm_bad_length(int alg_arg, int bits_arg,
                                data_t *client_key, data_t *server_key)
{
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0, lv = 0, lc = 0;

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, (uint32_t) bits_arg,
                                   client_key, server_key, NULL, 0) == 1);

    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE, shareV, lv));

    /* A confirmation MAC truncated below its true length must be rejected. */
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    TEST_ASSERT(lc > 1);
    TEST_EQUAL(psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM, confirm, lc - 1),
               PSA_ERROR_INVALID_SIGNATURE);

exit:
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_role_mismatch(int alg_arg, int bits_arg, data_t *client_key)
{
    /* A key pair (Prover material) must not be accepted for the server role. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t op = psa_pake_operation_init_short();
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;

    PSA_INIT();

    psa_pake_cs_set_algorithm(&cs, alg);
    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1,
                                                      (uint32_t) bits_arg));
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_DERIVE);
    psa_set_key_algorithm(&attr, alg);
    psa_set_key_type(&attr, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    PSA_ASSERT(psa_import_key(&attr, client_key->x, client_key->len, &key));

    PSA_ASSERT(psa_pake_setup(&op, key, &cs));
    TEST_EQUAL(psa_pake_set_role(&op, PSA_PAKE_ROLE_SERVER),
               PSA_ERROR_INVALID_ARGUMENT);

exit:
    psa_destroy_key(key);
    psa_pake_abort(&op);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_password_mismatch(int alg_arg, int bits_arg,
                               data_t *client_key, data_t *server_key)
{
    /* client_key and server_key are registration material derived from
     * *different* passwords (different w0). The key-share exchange has no
     * cross-check and must succeed, but the key schedules differ, so the
     * confirmation MAC must be rejected (the core PAKE "wrong password"
     * guarantee). */
    psa_algorithm_t alg = alg_arg;
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t confirm[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0, lv = 0, lc = 0;

    PSA_INIT();

    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, (uint32_t) bits_arg,
                                   client_key, server_key, NULL, 0) == 1);

    /* Key shares are exchanged successfully despite the mismatch. */
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    PSA_ASSERT(psa_pake_input(&server, PSA_PAKE_STEP_KEY_SHARE, shareP, lp));
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    PSA_ASSERT(psa_pake_input(&client, PSA_PAKE_STEP_KEY_SHARE, shareV, lv));

    /* The verifier's confirmation does not match what the prover derived. */
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_CONFIRM,
                               confirm, sizeof(confirm), &lc));
    TEST_EQUAL(psa_pake_input(&client, PSA_PAKE_STEP_CONFIRM, confirm, lc),
               PSA_ERROR_INVALID_SIGNATURE);

exit:
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_key_share_format(int alg_arg, int bits_arg, int expected_len,
                              data_t *client_key, data_t *server_key)
{
    /* psa_pake_output(KEY_SHARE) must emit an uncompressed SEC1 point of the
     * curve's fixed length for both the Prover and the Verifier, consistent
     * with PSA_PAKE_OUTPUT_SIZE(). */
    psa_algorithm_t alg = alg_arg;
    psa_pake_primitive_t prim = PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                   PSA_ECC_FAMILY_SECP_R1,
                                                   (uint32_t) bits_arg);
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    uint8_t shareV[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0, lv = 0;

    PSA_INIT();

    TEST_EQUAL(PSA_PAKE_OUTPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE),
               (size_t) expected_len);

    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, (uint32_t) bits_arg,
                                   client_key, server_key, NULL, 0) == 1);

    /* Prover (client) key share. */
    PSA_ASSERT(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, sizeof(shareP), &lp));
    TEST_EQUAL(lp, (size_t) expected_len);
    TEST_EQUAL(shareP[0], 0x04);

    /* Verifier (server) key share. */
    PSA_ASSERT(psa_pake_output(&server, PSA_PAKE_STEP_KEY_SHARE,
                               shareV, sizeof(shareV), &lv));
    TEST_EQUAL(lv, (size_t) expected_len);
    TEST_EQUAL(shareV[0], 0x04);

exit:
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SOME_SPAKE2P */
void spake2p_key_share_buffer_too_small(int alg_arg, int bits_arg,
                                        data_t *client_key, data_t *server_key)
{
    /* An output buffer shorter than the key share must be rejected with
     * PSA_ERROR_BUFFER_TOO_SMALL, never silently truncated. */
    psa_algorithm_t alg = alg_arg;
    psa_pake_primitive_t prim = PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                   PSA_ECC_FAMILY_SECP_R1,
                                                   (uint32_t) bits_arg);
    psa_pake_operation_t client = psa_pake_operation_init_short();
    psa_pake_operation_t server = psa_pake_operation_init_short();
    size_t share_len = PSA_PAKE_OUTPUT_SIZE(alg, prim, PSA_PAKE_STEP_KEY_SHARE);
    uint8_t shareP[PSA_PAKE_OUTPUT_MAX_SIZE];
    size_t lp = 0;

    PSA_INIT();

    TEST_ASSERT(share_len > 1);
    TEST_ASSERT(spake2p_setup_pair(&client, &server, alg, (uint32_t) bits_arg,
                                   client_key, server_key, NULL, 0) == 1);

    TEST_EQUAL(psa_pake_output(&client, PSA_PAKE_STEP_KEY_SHARE,
                               shareP, share_len - 1, &lp),
               PSA_ERROR_BUFFER_TOO_SMALL);

exit:
    psa_pake_abort(&client);
    psa_pake_abort(&server);
    PSA_DONE();
}
/* END_CASE */

/* BEGIN_CASE depends_on:PSA_WANT_ALG_SPAKE2P_HMAC:PSA_WANT_ALG_SPAKE2P_MATTER:PSA_WANT_ALG_SHA_256:PSA_WANT_ALG_HMAC:PSA_WANT_ECC_SECP_R1_256 */
void spake2p_setup_bad_policy(data_t *client_key)
{
    /* psa_pake_setup() must enforce the password key's policy: the key needs
     * PSA_KEY_USAGE_DERIVE, and its permitted algorithm must cover the cipher
     * suite algorithm. */
    psa_algorithm_t hmac = PSA_ALG_SPAKE2P_HMAC(PSA_ALG_SHA_256);
    psa_pake_cipher_suite_t cs = psa_pake_cipher_suite_init();
    psa_pake_operation_t op = psa_pake_operation_init_short();
    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
    mbedtls_svc_key_id_t key = MBEDTLS_SVC_KEY_ID_INIT;

    PSA_INIT();

    psa_pake_cs_set_primitive(&cs, PSA_PAKE_PRIMITIVE(PSA_PAKE_PRIMITIVE_TYPE_ECC,
                                                      PSA_ECC_FAMILY_SECP_R1, 256));
    psa_set_key_type(&attr, PSA_KEY_TYPE_SPAKE2P_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
    psa_set_key_algorithm(&attr, hmac);

    /* Case 1: the key lacks PSA_KEY_USAGE_DERIVE. */
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_EXPORT);
    PSA_ASSERT(psa_import_key(&attr, client_key->x, client_key->len, &key));
    psa_pake_cs_set_algorithm(&cs, hmac);
    TEST_EQUAL(psa_pake_setup(&op, key, &cs), PSA_ERROR_NOT_PERMITTED);
    psa_pake_abort(&op);
    psa_destroy_key(key);

    /* Case 2: the key policy permits HMAC, but the cipher suite asks for
     * the Matter (distinct) algorithm. */
    psa_set_key_usage_flags(&attr, PSA_KEY_USAGE_DERIVE);
    PSA_ASSERT(psa_import_key(&attr, client_key->x, client_key->len, &key));
    psa_pake_cs_set_algorithm(&cs, PSA_ALG_SPAKE2P_MATTER);
    TEST_EQUAL(psa_pake_setup(&op, key, &cs), PSA_ERROR_NOT_PERMITTED);

exit:
    psa_destroy_key(key);
    psa_pake_abort(&op);
    PSA_DONE();
}
/* END_CASE */
